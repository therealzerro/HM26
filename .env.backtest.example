# Backtest harness environment — Node-only, NOT loaded by Expo
# Copy this file to .env.backtest and fill in real values

# Supabase project URL (same value as EXPO_PUBLIC_SUPABASE_URL in main .env)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — from Supabase Dashboard → Project Settings → API → service_role
# This key has full DB access. NEVER put it in .env (the app's .env is bundled
# into the published build; service role key in a published build is a critical
# security incident).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
