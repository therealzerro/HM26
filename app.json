{
  "expo": {
    "name": "HitMaster",
    "slug": "hitmaster",
    "version": "2.0.0",
    "description": "HitMaster ZK6 — a data intelligence platform for numerical pattern analysis.",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "hitmaster",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hitmaster.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0a0613"
      },
      "package": "com.hitmaster.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0a0613"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#7c3aed",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c432e8dc-0437-4a60-9635-d2116fc4039b"
      }
    }
  }
}
