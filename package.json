{
  "name": "hitmaster",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "scripts": {
    "start": "scripts/ensure-swap.sh; expo start --port 8081",
    "start-tunnel": "scripts/ensure-swap.sh; expo start --tunnel --port 8081",
    "start-web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "test": "jest --testPathPattern='__tests__'",
    "backtest:report": "tsx scripts/backtest/cli.ts report",
    "backtest:replay": "tsx scripts/backtest/cli.ts replay",
    "backtest:diag-doubles": "tsx scripts/backtest/diag-doubles.ts",
    "intel:propose": "tsx scripts/intel-tuning/cli.ts",
    "autotune:propose": "tsx scripts/intel-tuning/generate-proposal.ts",
    "rebuild:datasets": "tsx scripts/intel-tuning/rebuild-datasets.ts",
    "rebuild:pair-datasets": "tsx scripts/intel-tuning/rebuild-pair-datasets.ts",
    "compute:daily-auc": "tsx scripts/intel-tuning/compute-daily-auc.ts",
    "backfill:adaptive-tracking": "tsx scripts/intel-tuning/backfill-adaptive-tracking.ts",
    "backfill:parity": "tsx scripts/backfill/parity-check.ts",
    "backfill:gaps": "tsx scripts/backfill/detect-gaps.ts",
    "backfill:slate": "tsx scripts/backfill/backfill-slate.ts",
    "import:results": "tsx scripts/imports/import-results.ts",
    "calibrate:picks": "tsx scripts/calibration/fit_pick_probability.ts",
    "verify:hits": "tsx scripts/intel-tuning/verify-hits.ts",
    "cohort:overdue": "tsx scripts/cohort/overdue-cohort.ts",
    "rls:smoke": "tsx scripts/rls-smoke.ts",
    "zk6:parity": "tsx scripts/zk6-parity/run.ts",
    "check:brand-voice": "tsx scripts/check-brand-voice.ts",
    "sync:edge-shared": "cp -f lib/engineCore.ts supabase/functions/_shared/engineCore.ts && cp -f lib/dateUtils.ts supabase/functions/_shared/dateUtils.ts && echo 'OK supabase/functions/_shared/ synced from lib/'",
    "check:edge-shared": "diff -q lib/engineCore.ts supabase/functions/_shared/engineCore.ts && diff -q lib/dateUtils.ts supabase/functions/_shared/dateUtils.ts && echo 'OK supabase/functions/_shared/ in sync with lib/'",
    "backfill:di": "tsx scripts/backfill/backfill-di.ts",
    "reel:verify": "tsx scripts/render-verification-reel.ts && tsx scripts/assemble-verification-reel.ts && tsx scripts/publish-reels.ts verify",
    "reel:allday": "tsx scripts/render-allday-body.ts && tsx scripts/assemble-allday-reels.ts && tsx scripts/publish-reels.ts allday",
    "reel:midday": "tsx scripts/render-allday-body.ts --scope=midday && tsx scripts/assemble-allday-reels.ts --scope=midday && tsx scripts/publish-reels.ts midday",
    "reel:evening": "tsx scripts/render-allday-body.ts --scope=evening && tsx scripts/assemble-allday-reels.ts --scope=evening && tsx scripts/publish-reels.ts evening",
    "reel:publish": "tsx scripts/publish-reels.ts",
    "reel:check": "tsx scripts/check-reel-assets.ts",
    "social:dryrun": "tsx scripts/social-handoff-dryrun.ts",
    "endcard:build": "tsx scripts/build-endcard.ts",
    "panel:build": "tsx scripts/build-panels.ts",
    "stinger:build": "tsx scripts/build-stinger.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "ajv": "^8.18.0",
    "expo": "~54.0.36",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "html-to-image": "^1.11.13",
    "lucide-react-native": "^0.475.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "supabase": "^2.98.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
